# Set default behavior to automatically normalize line endings
* text=auto

# Source files - use LF in repository, auto-convert on checkout
*.c text
*.h text
*.s text
*.S text

# MPLAB project files
*.xml text
*.properties text
*.mk text
*.bash text eol=lf

# Windows batch files must have CRLF
*.bat text eol=crlf

# Binary files
*.hex binary
*.elf binary
*.o binary
*.a binary
*.lib binary